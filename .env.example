OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=
# ollama | bedrock
LLM_PROVIDER=ollama
# ollama | bedrock | vacio (sin fallback)
LLM_FALLBACK_PROVIDER=
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_REGION=us-east-2
BEDROCK_CONNECT_TIMEOUT_SECONDS=5
BEDROCK_READ_TIMEOUT_SECONDS=60
CHROMA_HOST=
CHROMA_PORT=
CHROMA_COLLECTION=
# Cuanto puede la coincidencia lexica corregir el ranking por distancia semantica.
# Defaults calibrados 2026-08-07 con un corpus de 2 documentos; reajustar cuando
# crezca el corpus. Ver Bety_AI/services/chroma_service.py::calcular_score_ranking.
CHROMA_PESO_LEXICO=0.1
CHROMA_LEXICA_MAXIMA_CONSIDERADA=3.0
# Penalizacion sumada a score_ranking cuando un fragmento menciona solo el
# nivel academico contrario al del perfil (pregrado/posgrado). No es un
# permiso de acceso, es una senal de relevancia -- el fragmento sigue
# pudiendo ganar si es mucho mas relevante. Ver
# Bety_AI/view_logic/busqueda_fragmentos.py::calcular_penalizacion_nivel_contrario.
PENALIZACION_NIVEL_CONTRARIO=0.25
REDIS_URL=
# Modes: pages - caracteres1200
DOCUMENT_FRAGMENTATION_MODE=pages
