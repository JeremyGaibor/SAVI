# =========================
# SAVI - .env.example
# =========================
# Este archivo contiene SOLO valores de ejemplo.
# No incluir contraseñas, tokens, claves, IP privadas ni credenciales reales.
# Copiar como .env y completar los valores reales por un canal seguro.

# -------------------------
# Ollama
# -------------------------
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=

# -------------------------
# Django / seguridad
# -------------------------
# Generar una clave distinta por entorno, por ejemplo con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DEBUG=False

# Ejemplos seguros. Reemplazar por los hosts reales del entorno.
ALLOWED_HOSTS=localhost,127.0.0.1,savi.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://savi.example.com

# En producción deben mantenerse en True cuando se utiliza HTTPS.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# -------------------------
# Proveedor LLM
# -------------------------
# Valores permitidos: ollama | bedrock
LLM_PROVIDER=ollama

# Valores permitidos: ollama | bedrock | vacío (sin fallback)
LLM_FALLBACK_PROVIDER=

# -------------------------
# AWS Bedrock
# -------------------------
# Estos valores no son secretos; ajustar según el entorno.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_REGION=us-east-2
BEDROCK_CONNECT_TIMEOUT_SECONDS=5
BEDROCK_READ_TIMEOUT_SECONDS=60

# Las credenciales AWS NO deben almacenarse aquí.
# Utilizar IAM Role, credenciales del entorno o mecanismos seguros de AWS.

# -------------------------
# ChromaDB
# -------------------------
CHROMA_HOST=
CHROMA_PORT=
CHROMA_COLLECTION=

# Cuánto puede la coincidencia léxica corregir el ranking por distancia semántica.
# Defaults calibrados 2026-08-07 con un corpus de 2 documentos; reajustar cuando
# crezca el corpus.
CHROMA_PESO_LEXICO=0.1
CHROMA_LEXICA_MAXIMA_CONSIDERADA=3.0

# Penalización sumada a score_ranking cuando un fragmento menciona solo el
# nivel académico contrario al del perfil (pregrado/posgrado). No constituye
# un permiso de acceso; funciona únicamente como señal de relevancia.
PENALIZACION_NIVEL_CONTRARIO=0.25

# -------------------------
# Redis
# -------------------------
REDIS_URL=

# -------------------------
# API SGA
# -------------------------
# Utilizar URLs de ejemplo en este archivo. Configurar los valores reales solo
# en el .env privado del servidor.
SGA_API_TOKEN_URL=https://sga.example.com/api/sga/token/
SGA_API_USUARIO_SESION_URL=https://sga.example.com/api/sga/usuario-sesion/

# Credenciales: dejar vacías en el archivo de ejemplo.
SGA_API_TOKEN_FIJO=
SGA_API_USUARIO=
SGA_API_PASSWORD=

# -------------------------
# Procesamiento documental
# -------------------------
# Modes: pages - caracteres1200
DOCUMENT_FRAGMENTATION_MODE=pages
